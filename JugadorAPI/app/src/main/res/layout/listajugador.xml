<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imagenJugador"
        android:layout_width="107dp"
        android:layout_height="107dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/idJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:text="ID del Jugador"
        app:layout_constraintBottom_toTopOf="@+id/nombreJugador"
        app:layout_constraintStart_toEndOf="@+id/imagenJugador"
        app:layout_constraintTop_toTopOf="@+id/imagenJugador" />

    <TextView
        android:id="@+id/nombreJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del Jugador"
        app:layout_constraintStart_toStartOf="@+id/idJugador"
        app:layout_constraintTop_toBottomOf="@+id/idJugador"
        app:layout_constraintBottom_toTopOf="@+id/posicionJugador" />

    <TextView
        android:id="@+id/posicionJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Posición"
        app:layout_constraintStart_toStartOf="@+id/nombreJugador"
        app:layout_constraintTop_toBottomOf="@+id/nombreJugador"
        app:layout_constraintBottom_toTopOf="@+id/dorsalJugador" />

    <TextView
        android:id="@+id/dorsalJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Dorsal"
        app:layout_constraintStart_toStartOf="@+id/posicionJugador"
        app:layout_constraintTop_toBottomOf="@+id/posicionJugador" />

</androidx.constraintlayout.widget.ConstraintLayout>
